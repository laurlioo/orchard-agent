DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DB_PATH=./orchard.db
# development | production；生产环境必须设置 JWT_SECRET
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=72
# 生产环境首次初始化管理员所需的密钥；生产环境留空会导致启动失败
SETUP_TOKEN=
# 生产默认关闭 /docs；本地开发默认打开。需要强制开关时用 true/false
# ENABLE_DOCS=false
# CORS_ORIGINS=https://your-frontend.vercel.app
# Turso 托管 SQLite（生产环境用，数据永久保存）
# 在 https://turso.tech 创建数据库后，分别复制以下两个值：
# DATABASE_URL 填 libsql://orchard-xxx.turso.io  （不带 authToken）
# DATABASE_AUTH_TOKEN 填 Turso 生成的 auth token
DATABASE_URL=
DATABASE_AUTH_TOKEN=
